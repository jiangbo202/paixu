{
  "name": "paixu-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs --dist",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:cloudflare": "wrangler dev",
    "deploy": "npm run build && wrangler d1 migrations apply paixu-db --remote && wrangler deploy",
    "upgrade:local": "node scripts/upgrade-local.mjs",
    "admin:init": "node scripts/admin.mjs init",
    "admin:reset": "node scripts/admin.mjs reset",
    "admin:init:cloudflare": "node scripts/admin.mjs init --cloudflare",
    "admin:reset:cloudflare": "node scripts/admin.mjs reset --cloudflare"
  },
  "devDependencies": { "wrangler": "4.151.3" }
}
